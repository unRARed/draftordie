doctype html
html
  head
    title Draft or Die
    meta(
      name="viewport"
      content="width=device-width,initial-scale=1"
    )
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "application",
      "data-turbo-track": "reload"
    = javascript_include_tag "application",
      "data-turbo-track": "reload", defer: true
    - if current_user
      meta name="current-user-id" content="#{current_user.id}"
    - if controller.controller_name == "drafts" && @draft
      meta name="draft-slug" content="#{@draft.slug}"
  body.c-layout
    - if controller.controller_name == "drafts" && @draft
      = turbo_stream_from @draft
    header.c-layout__header
      .c-layout__header__title
        = link_to "Draft or Die", root_path
      .c-layout__header__navigation
        = render "shared/navigation"
    main.c-layout__main
      - if flash.any?
        = render "shared/flash"
      = yield
    footer.c-layout__footer
        span &copy; #{Time.current.year} Draft or Die
