.c-draft__selection-prior
  - if draft.draft_board_state&.prior_selection
    strong Last pick:
    span< #{draft.draft_board_state.prior_selection.name}
  - if draft.draft_board_state&.next_selection
    - if draft&.next_selection
      .c-draft__deck__next
        strong On deck:
        span< #{draft.next_selection&.pairing&.team_name}
