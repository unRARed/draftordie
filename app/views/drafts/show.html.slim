ruby:
  if @draft.users.include?(current_user)
    @navigation[:dynamic] << NavigationItem.new(
      'Leave this Draft',
      leave_draft_path(@draft),
      { method: :delete, data: { turbo_method: :delete } }
    )
    @navigation[:dynamic] << NavigationItem.new(
      'Commish Tools',
      edit_draft_path(@draft),
      options: {
        method: :delete,
        data: { turbo_method: :delete }
      }
    )
  else
    @navigation[:dynamic] << NavigationItem.new(
      text: 'Join this Draft',
      url: join_draft_path(@draft),
      options: { method: :post, data: { turbo_method: :post } }
    )
  end
  if policy(@draft).commish?
    @navigation[:dynamic] << NavigationItem.new(
      'Commish Tools',
      commish_draft_path(@draft),
      options: edit_draft_path(@draft)
    )
  end
css:
  .c-draft__board__slot {
    width: #{100 / [@draft.users.count, 1].max}%;
    font-size: #{compute_text_size(@draft.users.count)}px;
  }
= turbo_stream_from(:progression)
div class="c-draft#{' c-draft--paused' if @draft.is_paused?}"
  = render partial: "drafts/board", locals: { draft: @draft }
  = render partial: "drafts/footer", locals: { draft: @draft }
