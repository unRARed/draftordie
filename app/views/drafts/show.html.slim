.c-layout__scoped
  - if @draft.is_running? && !@draft.is_ended?
    .grid.grid-cols-1.gap-8.md:grid-cols-2
      div
        = turbo_frame_tag dom_id(@draft.current_selection) do
          - if current_user == @draft.current_selection.user
            = render partial: "selections/form",
              locals: { selection: @draft.current_selection }
        .c-draft__info id="show_info_#{@draft.slug}"
          = render partial: "show_info",
            locals: { draft: @draft }
      .c-draft__picks id="show_picks_#{@draft.slug}"
        = render partial: "show_picks", locals: { draft: @draft }
    - if (!@draft.is_running? && \
        @draft.users.include?(current_user) \
    )
      = link_to 'Leave Draft',
        leave_draft_path(@draft),
        class: "c-button c-button--negative",
        method: :delete,
        data: { turbo_method: :delete }
  - else
    - if @draft.is_started?
      p The draft has ended.
    - else
      p.c-draft__waiting The draft has not started, yet.
