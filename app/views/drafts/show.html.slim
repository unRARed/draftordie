.c-layout__scoped.c-draft__dashboard
  - if @draft.is_running? && !@draft.is_ended?
    .grid.grid-cols-1.md:gap-8.md:grid-cols-3
      div.col-span-1
        .c-draft__info id="show_info_#{@draft.slug}"
          = render partial: "drafts/show_info",
            locals: { draft: @draft }
          - if policy(@draft.current_selection).edit_player_data?
            = render partial: "selections/participant_form",
              locals: { draft: @draft,
                selection: @draft.current_selection }
      .col-span-2.c-draft__picks id="show_picks_#{@draft.slug}"
        = render partial: "drafts/show_picks",
          locals: { draft: @draft }
    - if (!@draft.is_running? && \
        @draft.users.include?(current_user) \
    )
      = link_to 'Leave Draft',
        leave_draft_path(@draft),
        class: "c-button c-button--negative",
        method: :delete,
        data: { turbo_method: :delete }
  - else
    - if @draft.is_started?
      p The draft has ended.
    - else
      p.c-draft__waiting The draft is waiting to start.
javascript:
  setTimeout(function() {
    var turboBar = document.querySelector(".turbo-progress-bar");
    if (!turboBar) { return; }

    turboBar.style.display = "none";
  }, 2000);
