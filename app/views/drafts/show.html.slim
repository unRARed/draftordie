= content_for :draft_slug
  meta name="draft-slug" content="#{@draft.slug}"
= turbo_stream_from(:draft_show,
  channel: "DraftChannel", data: { slug: @draft.slug })
= turbo_stream_from(:draft_board,
  channel: "DraftChannel", data: { slug: @draft.slug })
div class="c-draft"
  - if !@draft.is_ended?
    div.c-draft__picks id="show_#{@draft.slug}"
      = render partial: "drafts/show",
        locals: { draft: @draft, user: current_user,
          selection: @draft.current_selection }
    - if !@draft.is_running? && @draft.users.include?(current_user)
      = link_to 'Leave Draft',
        leave_draft_path(@draft),
        class: "c-button c-button--negative",
        method: :delete,
        data: { turbo_method: :delete }
    .c-draft__footer id="footer_#{@draft.slug}"
      = render partial: "drafts/footer",
        locals: { draft: @draft }
  - else
    p The draft has ended.
