div id="pick_number_#{selection.pick_number}" class="#{draft_board_slot_class(selection)}"
  p
    span Rd. #{selection.round.number} Pick #{selection.pick_number}
    br
    - if selection.is_missed?
      span< Missed Pick
    - elsif selection.is_selected? && !selection.is_missed?
      span< = selection.name
  p.mt-0
    strong = selection&.pairing&.team_name || "Team Name Missing"
