div id="pick_number_#{selection.pick_number}" class="#{draft_board_slot_class(selection)}"
  strong Rd. #{selection.round.number} Pick #{selection.pick_number}
  - if selection.is_missed?
    span< Missed Pick
  - if selection.is_selected? && !selection.is_missed?
    span< #{selection.name} (#{selection.position})
  span Team:
  span< = selection&.pairing&.team_name || "Team Name Missing"
