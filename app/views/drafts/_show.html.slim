.grid.grid-cols-2.gap-8
  .c-draft__selections
    - draft.remaining_selections.each do |selection|
      div class="#{pick_class(selection, user)}"
        strong Pick #{selection.pick_number}
        span #{selection.player_name} (#{selection.position})
        span #{selection.user.email || 'Unknown User'}
  .c-draft__selection-form
    - if draft&.current_selection&.user == user
      .c-container--md
        = render partial: "selections/form",
          locals: { draft: draft,
            selection: draft.current_selection }
