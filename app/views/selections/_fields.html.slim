.grid.grid-cols-2.gap-8
  div
    .form-group.form-group--required
      = f.label :name, "Player",
        class: "c-form__label"
      = f.select :player_id,
        f.object.draft.remaining_players.\
          map { |p| ["[#{p.position}] #{p.name}", p.id] },
        { include_blank: true },
        class: "c-form__select"
    h3 Or Write-in...
    .form-group.form-group--required
      = f.label :write_in_name, "Name",
        class: "c-form__label"
      = f.text_field :write_in_name
    .form-group.form-group--required
      = f.label :write_in_position, "Position",
        class: "c-form__label"
      = f.number_field :write_in_position
