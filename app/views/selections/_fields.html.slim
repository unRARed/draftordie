- cache(f.object) do
  div
    .form-group.form-group--required.pb-2
      - select_list = Player.for_selection. \
        map{|p| [p.formatted_name, p.id]}
      - if local_assigns[:is_bulk] && f.object.player.present?
        - select_list << @draft.players_for_select[:selected]. \
          find { |p| p[1] == f.object.player_id }
      .c-fuzzy-select
        = f.hidden_field :player_id, value: f.object.player_id
        input.c-fuzzy-select__input.c-field(
          type="text" placeholder="Search for a player"
          value="#{f.object.name if f.object.is_selected?}"
        )
        = turbo_frame_tag dom_id(@draft, :players),
          src: players_draft_path(@draft),
          loading: :lazy
      ruby:
        # = f.select :player_id, select_list,
        #   { include_blank: " - Select Player - " },
        #   selected: f.object.player_id,
        #   class: "c-field"
    - unless local_assigns[:is_bulk]
    .c-panel__subpanel
      h4 Can't find players?
      p.text-xs Write em' in here! Be sure they were not already
        drafted by another team though!
      .grid.grid-cols-5.gap-1.pt-3
        .form-group.form-group--required.col-span-5
          = f.label :write_in_name, "Name",
            class: "c-form__label"
          = f.text_field :write_in_name,
            placeholder: local_assigns[:is_bulk] ? \
              "Write-in Name (optional)" : "",
            class: "c-field c-field--sm"
        .form-group.form-group--required.col-span-3
          = f.label :write_in_team, "Team",
            class: "c-form__label"
          = f.select :write_in_team,
            Player::TEAMS[:football].map { |t| [t, t] },
            { include_blank: " - Select Team - " },
            class: "c-field c-field--sm"
        .form-group.form-group--required.col-span-2
          = f.label :write_in_position, "Position",
            class: "c-form__label"
          = f.select :write_in_position,
            Player::POSITIONS[:football].map { |p| [p, p] },
            { include_blank: " - Select Position - " },
            class: "c-field c-field--sm"
