<div class="c-layout__focus c-panel">
  <div class="c-panel__focus">
  <h2>Sign up</h2>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "c-form" }) do |f| %>
    <%= invisible_captcha %>

    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :email %><br />
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "c-field" %>
    </div>

    <div class="field">
      <%= f.label :password %>
      <% if @minimum_password_length %>
      <em>(<%= @minimum_password_length %> characters minimum)</em>
      <% end %><br />
      <%= f.password_field :password, autocomplete: "new-password", class: "c-field" %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation %><br />
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "c-field" %>
    </div>

    <div class="c-form__actions">
      <%= f.submit "Sign up", class: "c-button c-button--positive" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
  </div>
</div>
