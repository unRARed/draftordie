<div class="c-layout__focus c-panel">
  <div class="c-panel__focus">
  <h2>Forgot your password?</h2>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { class: "c-form", method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :email %><br />
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="c-form__actions">
      <%= f.submit "Reset me", class: "c-button" %>
    </div>
  <% end %>
  <%= render "devise/shared/links" %>
  </div>
</div>
